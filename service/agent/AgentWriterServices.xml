<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- DAR-BE-207. Core's audit run update (darpan.audit.AuditRunUpdateSupport.words) asks for this by name when it is defined;
         core never imports this component. Internal only: called after an automation run, where no one is signed in. -->

    <service verb="write" noun="AuditRunWords" authenticate="anonymous-all" allow-remote="false" transaction="ignore">
        <description>The words of an audit run update, by Claude Haiku from the run's fact sheet: a headline and one next-step
            sentence per cause group, each checked against the fact sheet (darpan.agent.AuditRunWriter). Empty when the agent is
            off for the tenant (deployment switch, TenantSetting.agentEnabled) or the model gave nothing usable; then the email
            shows each cause's own fix and no headline.</description>
        <in-parameters>
            <parameter name="companyUserGroupId" required="true"/>
            <parameter name="facts" type="Map" required="true"><description>darpan.audit.AuditRunFacts.build</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="headline"/>
            <parameter name="fixes" type="Map"><description>{"&lt;rule&gt;|&lt;cause&gt;": sentence}</description></parameter>
        </out-parameters>
        <actions>
            <set field="words" from="darpan.agent.AuditRunWriter.write(ec, companyUserGroupId, facts)"/>
            <set field="headline" from="words.headline"/>
            <set field="fixes" from="words.fixes ?: [:]"/>
        </actions>
    </service>

    <!-- DAR-BE-320 phase 1b. Core's audit run update (darpan.audit.AuditRunUpdateSupport.reviewReads) asks for this by name
         when it is defined and the play's read report has flags. Internal only: runs after an automation run. -->
    <service verb="review" noun="AuditReads" authenticate="anonymous-all" allow-remote="false" transaction="ignore">
        <description>One staff ticket per tenant, read flag and connection (BrainChangeTicket, READ_ECONOMY_EXTRACT or
            READ_ECONOMY_BRAIN) from a play's read report, with Claude's diagnosis, suggestion and owner when the agent is on for
            the tenant (darpan.agent.AuditReadReviewer). A flag with an open ticket is not raised again. Never changes config or code.</description>
        <in-parameters>
            <parameter name="companyUserGroupId" required="true"/>
            <parameter name="auditId"/>
            <parameter name="readReport" type="Map" required="true"><description>darpan.audit.AuditReadReport.forPlay</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="tickets" type="List"><description>[{ticketId, flag, key, duplicate}]</description></parameter>
            <parameter name="reviewed" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="out" from="darpan.agent.AuditReadReviewer.review(ec, companyUserGroupId, auditId, readReport)"/>
            <set field="tickets" from="out.tickets"/>
            <set field="reviewed" from="out.reviewed"/>
        </actions>
    </service>

    <!-- DAR-BE-298. Core's account emails (darpan.email.EmailSmile.line) ask for this by name when it is defined. Internal
         only: a send may run where no one is signed in. Nothing about the reader goes to the model. -->
    <service verb="write" noun="EmailSmile" authenticate="anonymous-all" allow-remote="false" transaction="ignore">
        <description>One playful line for a Darpan account email, by Claude Haiku from the key's brief and the template's own
            line (darpan.agent.EmailSmileWriter). Empty when the deployment's agent switch is off, the key has no brief, or the
            model gave nothing usable; core then sends the template's line, and checks any line again before it goes.</description>
        <in-parameters>
            <parameter name="key" required="true"><description>The EmailTemplate id (a side suffix for the recovery email)</description></parameter>
            <parameter name="fallback"><description>The template's own line, given as the example</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="line"/>
        </out-parameters>
        <actions>
            <set field="line" from="darpan.agent.EmailSmileWriter.write(ec, key, fallback)"/>
        </actions>
    </service>

</services>
