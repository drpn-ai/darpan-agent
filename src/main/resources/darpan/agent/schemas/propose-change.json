{
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "target", "after", "reasonText", "evidence"],
  "properties": {
    "kind": {"type": "string", "enum": ["EXCLUSION_FILTER", "STATEMENT_NARROWING", "FIX_TEXT", "CONCLUSION_ROWS"]},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "description": "Only the keys of the kind, all required for it: EXCLUSION_FILTER {savedRunId, fileSide}; STATEMENT_NARROWING {auditId, checkCode, statementCode}; FIX_TEXT {savedRunId, conclusionCode}; CONCLUSION_ROWS {savedRunId}.",
      "properties": {
        "savedRunId": {"type": "string"},
        "fileSide": {"type": "string", "enum": ["FILE_1", "FILE_2"]},
        "auditId": {"type": "string"},
        "checkCode": {"type": "string"},
        "statementCode": {"type": "string"},
        "conclusionCode": {"type": "string"}
      }
    },
    "after": {
      "type": "object",
      "additionalProperties": false,
      "description": "Only the keys of the kind: EXCLUSION_FILTER {fieldExpression (leave it out to exclude by the run's primary id; set it only for another field the person names), operator (EXCLUDE_IN, or leave it out), filterValues (required, not empty; filterValues are added to the field's existing exclusions; you cannot remove an exclusion or change a scope)}; STATEMENT_NARROWING {diffTypes, conclusionCodes, ruleIds} (at least one, not empty); FIX_TEXT {fixActionTemplate (required, at most 1000 characters)}; CONCLUSION_ROWS {rows (required, not empty)}.",
      "properties": {
        "fieldExpression": {"type": "string"},
        "operator": {"type": "string", "enum": ["EXCLUDE_IN"]},
        "filterValues": {"type": "array", "items": {"type": "string"}},
        "diffTypes": {"type": "array", "items": {"type": "string"}},
        "conclusionCodes": {"type": "array", "items": {"type": "string"}},
        "ruleIds": {"type": "array", "items": {"type": "string"}},
        "fixActionTemplate": {"type": "string"},
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["conclusionCode"],
            "properties": {
              "conclusionCode": {"type": "string"},
              "parentConclusionCode": {"type": "string"},
              "bucket": {"type": "string"},
              "fixActionTemplate": {"type": "string"},
              "conditions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["fieldExpression", "operator"],
                  "properties": {
                    "fieldExpression": {"type": "string"},
                    "operator": {"type": "string"},
                    "checkValue": {"type": "string", "description": "For IN and NOT_IN, the values separated by commas."}
                  }
                }
              }
            }
          }
        }
      }
    },
    "reasonText": {"type": "string", "description": "Why, citing finding ids, record keys or fields; at most 1000 characters."},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "value", "source"],
        "properties": {
          "field": {"type": "string"},
          "value": {"type": "string"},
          "source": {"type": "string", "enum": ["HUMAN", "CONFIG", "TOOL"]}
        }
      }
    }
  }
}
